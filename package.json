{
  "name": "powermeta4",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cuadre:discover": "cross-env NODE_OPTIONS=--use-system-ca node --conditions=react-server --import tsx scripts/cuadre/discover.ts",
    "cuadre:verify": "cross-env NODE_OPTIONS=--use-system-ca node --conditions=react-server --import tsx scripts/cuadre/verify.ts",
    "cuadre:verify-local": "node --conditions=react-server --import tsx scripts/cuadre/verify-local.ts",
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev --turbopack",
    "build": "next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db-migrate.ts",
    "db:validate": "node --conditions=react-server --import tsx scripts/db-validate.ts",
    "db:bootstrap": "node --conditions=react-server --import tsx scripts/db-bootstrap.ts",
    "setup": "npm run db:migrate && npm run db:validate && npm run db:bootstrap",
    "kb:ingest": "node --use-system-ca --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/kb-manual-ingest.ts",
    "kb:status": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/kb-maintenance.ts status",
    "kb:export": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/kb-maintenance.ts export",
    "kb:import": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/kb-maintenance.ts import",
    "kb:publish": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/kb-maintenance.ts publish",
    "kb:evaluate": "node --use-system-ca --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/kb-manual-evaluate.ts",
    "chat:evaluate": "cross-env NODE_ENV=development node --use-system-ca --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/chat/evaluate.ts",
    "portal:soap-catalog": "node --import tsx scripts/portal/soap-catalog.ts",
    "portal:docs": "node --import tsx scripts/portal/dependencias.ts",
    "portal:discover": "node --conditions=react-server --import tsx scripts/portal/descubrir.ts",
    "portal:certificate-discover": "node --conditions=react-server --import tsx scripts/portal/descubrir-certificado.ts",
    "portal:holidays-discover": "cross-env NODE_OPTIONS=--use-system-ca node --conditions=react-server --import tsx scripts/portal/descubrir-festivos.ts",
    "portal:verify": "cross-env NODE_OPTIONS=--use-system-ca node --conditions=react-server --import tsx scripts/portal/verificar.ts",
    "portal:readonly-audit": "cross-env NODE_OPTIONS=--use-system-ca node --conditions=react-server --import tsx scripts/portal/readonly-audit.ts",
    "quinquenal:verify": "cross-env NODE_OPTIONS=--use-system-ca node --conditions=react-server --import tsx scripts/quinquenal/verificar.ts",
    "retributivo:verify": "cross-env NODE_OPTIONS=--use-system-ca node --conditions=react-server --import tsx scripts/registro-retributivo/verificar.ts",
    "hire:model": "cross-env NODE_OPTIONS=--use-system-ca node --conditions=react-server --import tsx scripts/meta4/hire-model.ts && oxfmt src/lib/meta4/hire/direct/model.generated.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@assistant-ui/react": "latest",
    "@assistant-ui/react-markdown": "latest",
    "@floating-ui/dom": "^1.8.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@zip.js/zip.js": "^2.8.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.10.1",
    "koffi": "^3.1.5",
    "lucide-react": "^1.26.0",
    "motion": "^12.43.0",
    "mssql": "^12.7.2",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.17.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^0.12.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@assistant-ui/next": "latest",
    "@napi-rs/canvas": "^0.1.100",
    "@tailwindcss/postcss": "^4.3.3",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "pdfjs-dist": "^5.7.284",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15 <25"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "koffi@3.1.5": true
  }
}
