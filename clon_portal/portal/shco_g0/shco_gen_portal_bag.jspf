  Tran_shco_g0.load(pageContext,zTranslationsPath + "shco_g0_" +zlanguser + ".properties");
  session.setAttribute("Tran_shco_g0",Tran_shco_g0);
  session.setAttribute ("zcssuser",zSHCO_CSS);
%>