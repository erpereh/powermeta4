<%!
/**
 * Splits an string in a substring array.
 */
 String[] splitString(String ai_text, String ai_separator)
 {
    StringTokenizer st = new StringTokenizer(ai_text, ai_separator);
    String[] tokens = new String[st.countTokens()];
    int i=0;
    while (st.hasMoreTokens()) {
        tokens[i++] = st.nextToken();
    }

    return tokens;
 }
%>
