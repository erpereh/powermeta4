<%-- ******************** Mapeamos a ficheros donde se encuentran etiquetas traducidas   ******************** --%>

<%
	
	com.meta4.redirect.M4PropertiesRedirect gTranslateAdmin = new com.meta4.redirect.M4PropertiesRedirect();
	
	M4SessionManager m4session = M4Context.getSession(request);
	int iLanguageId = m4session.getLanguageID();
	String sLanguage = "es";

	sLanguage = CheckConfig.checkLocale(iLanguageId);
		
	String sFileName = "/translations/tcadmin_soapservices_" + sLanguage + ".properties";
	
	gTranslateAdmin.load(pageContext,sFileName);
	
%>
