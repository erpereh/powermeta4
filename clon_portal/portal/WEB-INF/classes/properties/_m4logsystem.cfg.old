#======================================================================
# @(#) FileVersion: 819.005.016
# @(#) FileDescription: Configuration file for java log system.
# @(#) CompanyName: Meta4 Spain, S.A.
# @(#) LegalCopyright: (c) 2022
# @(#) ProductName: PeopleNet
#======================================================================

status = error
dest = err
name = m4logsystem.cfg

#======================================================================
# Properties
#======================================================================

property.m4tracelevel = warn
property.m4directory = ${sys:user.home}/meta4/logs/m4webservices

property.m4filepattern = %i.log.gz
property.m4layoutpattern = %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %5p: %m%n
property.m4policiessize = 10MB
property.m4strategymax = 5

#======================================================================
# Root
#======================================================================

rootLogger.level = ${m4tracelevel}
rootLogger.appenderRef.m4default.ref = m4default

#======================================================================
# m4default
#======================================================================

appender.m4default.type = RollingFile
appender.m4default.name = m4default
appender.m4default.fileName = ${m4directory}/webservices.log
appender.m4default.filePattern = ${m4directory}/webservices-${m4filepattern}
appender.m4default.createOnDemand = true
appender.m4default.layout.type = PatternLayout
appender.m4default.layout.pattern = ${m4layoutpattern}
appender.m4default.policies.type = Policies
appender.m4default.policies.size.type = SizeBasedTriggeringPolicy
appender.m4default.policies.size.size = ${m4policiessize}
appender.m4default.strategy.type = DefaultRolloverStrategy
appender.m4default.strategy.max = ${m4strategymax}
appender.m4default.strategy.fileIndex = min

logger.m4default.name = com.meta4
logger.m4default.level = ${m4tracelevel}
logger.m4default.additivity = false
logger.m4default.appenderRef.m4default.ref = m4default

