<?xml version="1.0" encoding="UTF-8"?><!-- [=======================================================] --><!-- @(#)FileVersion: 811.000.001                              --><!-- @(#)FileDescription: Configuration file for m4webservices --><!-- @(#)CompanyName: Meta4 Spain, S.A.                         --><!-- @(#)LegalCopyright: (c)2014                         --><!-- @(#)ProductName: PeopleNet KSystem                            --><!-- @(#)ProductVersion: 8.1SP1                                --><!-- @(#)InternalName: configclient.xml                        --><!-- @(#)Date: 17/02/2011                                      --><!-- [=======================================================] --><!-- [=========================================================] --><!--                                                             --><!-- 1. Set entries like these between <THINCLIENT></THINCLIENT> --><!-- for initial operations with clear-text credentials:         --><!--                                                             --><!--           <USER>WEBADM</USER>                               --><!--           <PASSWD>WEBADM</PASSWD>                           --><!--                                                             --><!-- 2. Set entries like these between <THINCLIENT></THINCLIENT> --><!-- for initial operations with encrypted credentials:          --><!--                                                             --><!--           <User>WEBADM</User>                               --><!--           <EncPassFile>c:/path/webadmpass.bin</EncPassFile> --><!--                                                             --><!--  where c:/path/webadmpass.bin is the file containing the    --><!--  encrypted password for the user included in the <USER> tag --><!--                                                             --><!-- 3. Set entries like these between <THINCLIENT></THINCLIENT> --><!-- to allow the session cookie to have an alternative name,    --><!-- which may be useful for machines with more than one site.   --><!--                                                             --><!-- 		<SessionCookieID>M4lhcl</SessionCookieID>                --><!--                                                             --><!-- [=========================================================] --><!-- Do not enter comments below this line.  --><!-- @(#)FileVersion: 811.000.026                              --><!-- @(#)ProductName: PeopleNet KSystem                                --><!-- @(#)Date: 04/07/2014                                      --><!-- @(#)FileVersion: 812.000.043                              --><!-- @(#)FileVersion: 812.002.066                              --><!-- @(#)FileVersion: 813.000.074                              --><!-- @(#)FileVersion: 813.001.089                              --><!-- @(#)FileVersion: 814.000.006                              --><!-- @(#)LegalCopyright: (c)2017                         --><!-- @(#)ProductVersion: 8.1SP4                                --><!-- @(#)Date: 21/10/2016                                      --><!-- @(#)FileVersion: 814.001.006                              --><!-- @(#)FileVersion: 815.001.005                               --><!-- @(#) FileDescription: Configuration file for m4webservices. --><!-- @(#)LegalCopyright: (c)2018                               --><!-- @(#)ProductName: PeopleNet                                 --><!-- @(#) FileVersion: 816.000.009                               --><!-- @(#) CompanyName: Meta4 Spain, S.A.                         --><!-- @(#) LegalCopyright: (c) 2018                               --><!-- @(#) ProductName: PeopleNet                                 --><M4Client>
  <THINCLIENT>
    <User>M4ADM</User>
    <EncPassFile>C:\\Program Files (x86)\\Meta4\\M4WS\\produccion\\WEB-INF\\classes\\properties\\webadmpass.bin</EncPassFile>
    <DEFAULTPAGE>/servlet/CheckSecurity/JSP/sse_generico/generico_invisible.jsp</DEFAULTPAGE>
    <STYLESHEET>tc_login.css</STYLESHEET>
    <THINCLIENTROOT/>
    <ExternalContentProvider>
      <URL_0>http://localhost/servlet/SignOn</URL_0>
      <Local>/servlet/CrossPoster</Local>
      <TrustStore>trust-store-file-name</TrustStore>
      <TrustPassword>changeit</TrustPassword>
    </ExternalContentProvider>
    <SavParamsInterface>
      <GlobalConfiguration>
        <SECTION_0>ADMINISTRATION</SECTION_0>
      </GlobalConfiguration>
      <UserConfiguration>
        <SECTION_0>FORMAT</SECTION_0>
        <SECTION_1>PORTAL_PARAM</SECTION_1>
      </UserConfiguration>
    </SavParamsInterface>
    <DynExtension>
      <ParamType>
        <CLASS_0>com.meta4.savparams.GlobalSavParams</CLASS_0>
        <METHOD_0>loadGlobalSavParamsInstance</METHOD_0>
      </ParamType>
    </DynExtension>
    <UPLOADDIR>c:\temp</UPLOADDIR>
    <MAXFILESIZE>50000</MAXFILESIZE>
    <Languages>
      <Language_2>
        <login>/sse_generico/english/generico_login_cyc.jsp?estado=1</login>
        <Error>/shco_g0/english/shco_show_error.jsp</Error>
