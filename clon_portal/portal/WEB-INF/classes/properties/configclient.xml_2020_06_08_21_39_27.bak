  <WEBSERVERPORT>8200</WEBSERVERPORT>
  <WEBSERVERSECUREPORT>8243</WEBSERVERSECUREPORT>
  <SSL>no</SSL>
  <PATHCERTIFICATE>C:\\Program Files (x86)\\Meta4\\M4WS\\produccion\\WEB-INF\\classes\\properties\\cacert.pem</PATHCERTIFICATE>
  <TIMEOUTINACTIVITY>3600</TIMEOUTINACTIVITY>
