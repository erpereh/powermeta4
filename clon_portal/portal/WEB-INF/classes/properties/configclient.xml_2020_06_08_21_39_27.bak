    <SERVER_0>peoplenetweb.CREDITOCAUCION.ES</SERVER_0>
    <PORT_0>4102</PORT_0>
    <PORTSECURE_0>4103</PORTSECURE_0>
    <COUNT>1</COUNT>
  </APPSERVER>
  <ANONYMOUS>
    <USER>ANONYMOUS</USER>
    <PASSWORD>ANONYMOUSP</PASSWORD>
    <MAXNUMBERSESSIONS>128</MAXNUMBERSESSIONS>
  </ANONYMOUS>
  <IndirectSSO>
    <filepath>ca-saml.p12</filepath>
    <keypass>changeit</keypass>
    <interval>600</interval>
    <margin>60</margin>
    <portalprotocol>https</portalprotocol>
    <portalport>443</portalport>
    <portallogonpattern>sse_generico/generico_login.jsp</portallogonpattern>
    <portaldefaulturi>/servlet/CheckSecurity/JSP/sse_generico/ssco_portal.jsp</portaldefaulturi>
    <updatesurl>https://www.domain.com/hr</updatesurl>
    <richappserver>localhost</richappserver>
    <samlslouri/>
    <net>
      <netupdatesurl>https://customer.domain.com/hrprof/m4richwebnet.html</netupdatesurl>
      <netupdservice>https://customer.domain.com/hrprof</netupdservice>
      <netappserver>DefaultServer</netappserver>
      <netlogonpattern>/hrpn8</netlogonpattern>
      <forwardedproto/>
    </net>
    <oauthprotocol/>
    <oauthport/>
		<authrelaycookie>authrelay</authrelaycookie>
		<authrelaydomain>meta4.com</authrelaydomain>
  </IndirectSSO>
  <URIRENAMER>
    <ALLCACHEABLEEXTENSIONS>js jsp htm html css xml gif jpg png svg woff2</ALLCACHEABLEEXTENSIONS>
    <EXCLUSIONS>
      <EXCLUSION0>/hrpn8/welcome/meta4/.*</EXCLUSION0>
    </EXCLUSIONS>
  </URIRENAMER>
  <ADDHEADERS>
    <EXPIRE0>/servlet/SafePageProvider;-1</EXPIRE0>
    <EXPIRE1>/servlet/login;-1</EXPIRE1>
    <EXPIRE2>/temp/;-1</EXPIRE2>
    <EXPIRE3>\.jsp$;-1</EXPIRE3>
  </ADDHEADERS>
  <ObjectCache>
    <maxMemoryUpperLevel>10000000</maxMemoryUpperLevel>
    <maxMemoryLowerLevel>8000000</maxMemoryLowerLevel>
  </ObjectCache>
  <SESSIONVERIFIER>
    <ENABLED>true</ENABLED>
    <COOKIENAME>m4svctx</COOKIENAME>
    <COOKIEDOMAIN>meta4.com</COOKIEDOMAIN>
    <URL>http://internalurl.domain.com/servlet/SessionVerifier</URL>
  </SESSIONVERIFIER>
  <SERVICELIMITS>
    <ENABLED>true</ENABLED>
  </SERVICELIMITS>
  <M4JSAPI>
    <enabledeltas>true</enabledeltas>
  </M4JSAPI>
  <CUSTOMIZER>
    <FULLTEXTREPLACEMENT>true</FULLTEXTREPLACEMENT>
    <CHANGETEXTEXTENSIONS>jsp js html htm</CHANGETEXTEXTENSIONS>
    <JSINJECTIONEXCLUDE>\.js$</JSINJECTIONEXCLUDE>
    <JSINJECTIOENABLERTL>true</JSINJECTIOENABLERTL>
    <JSINJECTIOENABLELTR>true</JSINJECTIOENABLELTR>
    <JSINJECTIONURI/>
  </CUSTOMIZER>
</M4Client>