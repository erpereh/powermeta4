    </Languages>
		<REPLICABLESESSIONS>false</REPLICABLESESSIONS>
		<REPLICABLESESSIONSDOMAIN>meta4.com</REPLICABLESESSIONSDOMAIN>
		<REPLICABLESESSIONSCONNECTIONDURATION>86400</REPLICABLESESSIONSCONNECTIONDURATION>
		<REPLICABLESESSIONSCHECKFREQUENCY>3600</REPLICABLESESSIONSCHECKFREQUENCY>
  </THINCLIENT>
  <NDC>
    <WriteIPAddress>true</WriteIPAddress>
    <WriteSessionID>false</WriteSessionID>
    <WriteLogSource>false</WriteLogSource>
  </NDC>
  <MainProductID/>
