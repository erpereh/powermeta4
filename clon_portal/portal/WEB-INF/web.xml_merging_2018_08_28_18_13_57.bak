<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/dtd/web-app_2_3.dtd">

<!-- [=====================================================] -->
<!-- @(#)FileVersion: 811.000.011 -->
<!-- @(#)FileDescription:Web Deployment Descriptor (DD) -->
<!-- @(#)CompanyName: Meta4 Spain, S.A. -->
<!-- @(#)LegalCopyright: (c)2014 -->
<!-- @(#)ProductName: PeopleNet KSystem -->
<!-- @(#)ProductVersion: 8.1SP1 -->
<!-- @(#)InternalName: web.xml -->
<!-- @(#)Date: 11/10/2013 -->
<!-- [=====================================================] -->
<!-- This web.xml is valid for Tomcat and standard containers -->
<!-- This web.xml matches Servlet 2.3 strict -->
<!-- AXIS Support: v1.4 -->
<!-- Includes kaptcha servlet. For a complete list of init-parameters: 
	 http://code.google.com/p/kaptcha/wiki/ConfigParameters -->
<!-- Recommended filter order: M4BenchFilter, M4AddHeadersFilter
	 M4WebSSOFilter, M4SOAPAutoGenerationFilter, M4RequestEncodingFilter, 
	 M4CheckAccessFilter, M4URIRenamer, M4SecurityHandlerFilter, M4JSFilter,
	 M4RedirectFilter  -->
<!-- [=====================================================] -->
<web-app>
  <display-name>Meta4 Tag Library Web Application</display-name>
  <description>Meta4 Tag Library Web Application</description>
  <filter>
    <filter-name>M4BenchFilter</filter-name>
    <filter-class>com.meta4.filters.bench.M4BenchFilter</filter-class>
  </filter>
  <filter>
    <filter-name>M4AddHeadersFilter</filter-name>
    <filter-class>com.meta4.filters.addheaders.M4AddHeadersFilter</filter-class>
    <init-param>
      <param-name>enable</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter>
    <filter-name>M4WebSSOFilter</filter-name>
    <filter-class>com.meta4.filters.websso.M4WebSSOFilter</filter-class>
    <init-param>
      <param-name>netpattern</param-name>
      <param-value>^/hrprof</param-value>
    </init-param>
    <init-param>
      <param-name>adbpattern</param-name>
      <param-value>^/adb</param-value>
    </init-param>
    <init-param>
      <param-name>richwebpattern</param-name>
      <param-value>^/rw</param-value>
    </init-param>
    <init-param>
      <param-name>esspattern</param-name>
      <param-value>/</param-value>
    </init-param>
    <init-param>
      <param-name>enable</param-name>
      <param-value>false</param-value>
    </init-param>
  </filter>
  <filter>
    <filter-name>M4SOAPAutoGenerationFilter</filter-name>
    <filter-class>com.meta4.filters.soapservices.M4SOAPAutoGenerationFilter</filter-class>
    <init-param>
      <param-name>enable</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter>
    <filter-name>M4RequestEncodingFilter</filter-name>
    <filter-class>com.meta4.filters.i18n.M4RequestEncodingFilter</filter-class>
    <init-param>
      <param-name>enable</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter>
    <filter-name>M4CheckAccessFilter</filter-name>
    <filter-class>com.meta4.filters.access.M4CheckAccessFilter</filter-class>
  </filter>
  <filter>
    <filter-name>M4URIRenamer</filter-name>
    <filter-class>com.meta4.filters.urirenamer.M4URIRenamerFilter</filter-class>
    <init-param>
      <param-name>enable</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter>
    <filter-name>M4SecurityHandlerFilter</filter-name>
    <filter-class>com.meta4.filters.security.M4SecurityHandlerFilter</filter-class>
    <init-param>
      <param-name>enable</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter>
    <filter-name>M4JSFilter</filter-name>
    <filter-class>com.meta4.filters.js.M4JSFilter</filter-class>
    <init-param>
      <param-name>enable</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter>
    <filter-name>M4RedirectFilter</filter-name>
    <filter-class>com.meta4.filters.redirect.M4RedirectFilter</filter-class>
    <init-param>
      <param-name>enable</param-name>
      <param-value>true</param-value>
    </init-param>
    <init-param>
      <param-name>exclude</param-name>
      <param-value>^/temp/</param-value>
    </init-param>
    <init-param>
      <param-name>expire1</param-name>
      <param-value>\.png$;86400</param-value>
    </init-param>
    <init-param>
      <param-name>expire2</param-name>
      <param-value>\.gif$;86400</param-value>
    </init-param>
    <init-param>
      <param-name>expire3</param-name>
      <param-value>\.jpg$;86400</param-value>
    </init-param>
    <init-param>
      <param-name>expire4</param-name>
      <param-value>\.css$;86400</param-value>
    </init-param>
    <init-param>
      <param-name>expire5</param-name>
      <param-value>library/jquery-.*\.js;5184000</param-value>
    </init-param>
    <init-param>
      <param-name>expire6</param-name>
      <param-value>library/jquery.mobile-.*\.js;5184000</param-value>
    </init-param>
    <init-param>
      <param-name>expire7</param-name>
      <param-value>m4jsapi/[A-Z0-9]*\.cache\.js;5184000</param-value>
    </init-param>
    <init-param>
      <param-name>expire8</param-name>
      <param-value>libreria/mootools-.*\.js;5184000</param-value>
    </init-param>
    <init-param>
      <param-name>expire9</param-name>
      <param-value>\.js$;3600</param-value>
    </init-param>
    <init-param>
      <param-name>expire10</param-name>
      <param-value>\.html$;86400</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>M4BenchFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4AddHeadersFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4AddHeadersFilter</filter-name>
    <url-pattern>*.jsp</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4WebSSOFilter</filter-name>
    <url-pattern>*.jsp</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4SOAPAutoGenerationFilter</filter-name>
    <url-pattern>/services/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4SOAPAutoGenerationFilter</filter-name>
    <url-pattern>/servlet/AxisServlet</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4RequestEncodingFilter</filter-name>
    <url-pattern>*.jsp</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4CheckAccessFilter</filter-name>
    <url-pattern>/temp/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4URIRenamer</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4SecurityHandlerFilter</filter-name>
    <url-pattern>/servlet/M4JSExecutor/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4SecurityHandlerFilter</filter-name>
    <url-pattern>*.jsp</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4SecurityHandlerFilter</filter-name>
    <url-pattern>*.html</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4SecurityHandlerFilter</filter-name>
    <url-pattern>*.htm</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4SecurityHandlerFilter</filter-name>
    <url-pattern>*.js</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4SecurityHandlerFilter</filter-name>
    <url-pattern>/servlet/login</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4SecurityHandlerFilter</filter-name>
    <url-pattern>/servlet/SafePageProvider</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4JSFilter</filter-name>
    <url-pattern>*.js</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4JSFilter</filter-name>
    <url-pattern>*.jsp</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4JSFilter</filter-name>
    <url-pattern>*.html</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4JSFilter</filter-name>
    <url-pattern>*.htm</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4RedirectFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4JSAPIFilter</filter-name>
    <url-pattern>/servlet/M4JSExecutor/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>M4JSAPIFilter</filter-name>
    <url-pattern>/servlet/M4JSServices/*</url-pattern>
  </filter-mapping>
  <servlet>
    <servlet-name>Kaptcha</servlet-name>
    <servlet-class>com.google.code.kaptcha.servlet.KaptchaServlet</servlet-class>
    <init-param>
      <param-name>kaptcha.border</param-name>
      <param-value>no</param-value>
    </init-param>
    <init-param>
      <param-name>kaptcha.textproducer.font.color</param-name>
      <param-value>black</param-value>
    </init-param>
    <init-param>
      <param-name>kaptcha.textproducer.char.space</param-name>
      <param-value>5</param-value>
    </init-param>
  </servlet>
  <servlet>
    <servlet-name>CheckSecurity</servlet-name>
    <servlet-class>com.meta4.tcservlets.CheckSecurity</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>DateServlet</servlet-name>
    <servlet-class>com.meta4.tcservlets.DateServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>DocumentViewer</servlet-name>
    <servlet-class>com.meta4.tcservlets.DocumentViewer</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>download_blob</servlet-name>
    <servlet-class>com.meta4.tcservlets.download_blob</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>com.meta4.tcservlets.login</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>SafePageProvider</servlet-name>
    <servlet-class>com.meta4.tcservlets.SafePageProvider</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>SignOn</servlet-name>
    <servlet-class>com.meta4.tcservlets.SignOn</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>CrossPoster</servlet-name>
    <servlet-class>com.meta4.tcservlets.CrossPoster</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>M4JSExecutor</servlet-name>
    <servlet-class>com.meta4.js.server.M4ServiceImpl</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>M4JSServices</servlet-name>
    <servlet-class>com.meta4.js.server.M4Services</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>PortalLogin</servlet-name>
    <servlet-class>com.meta4.tcservlets.PortalLogin</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>M4RestServlet</servlet-name>
    <servlet-class>com.meta4.rest.M4RestServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>AxisServlet</servlet-name>
    <display-name>Apache-Axis Servlet</display-name>
    <servlet-class>org.apache.axis.transport.http.AxisServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>AdminServlet</servlet-name>
    <display-name>Axis Admin Servlet</display-name>
    <servlet-class>org.apache.axis.transport.http.AdminServlet</servlet-class>
    <load-on-startup>100</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>M4FileDownloadServlet</servlet-name>
    <servlet-class>com.meta4.appclient.filedownload.M4FileDownloadServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>Kaptcha</servlet-name>
    <url-pattern>/images/kaptcha.jpg</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>CheckSecurity</servlet-name>
    <url-pattern>/servlet/CheckSecurity/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>DateServlet</servlet-name>
    <url-pattern>/servlet/DateServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>DocumentViewer</servlet-name>
    <url-pattern>/servlet/DocumentViewer</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>download_blob</servlet-name>
    <url-pattern>/servlet/download_blob</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/servlet/login</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>SafePageProvider</servlet-name>
    <url-pattern>/servlet/SafePageProvider</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>SignOn</servlet-name>
    <url-pattern>/servlet/SignOn</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>CrossPoster</servlet-name>
    <url-pattern>/servlet/CrossPoster</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>M4JSExecutor</servlet-name>
    <url-pattern>/servlet/M4JSExecutor</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>M4JSServices</servlet-name>
    <url-pattern>/servlet/M4JSServices/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PortalLogin</servlet-name>
    <url-pattern>/servlet/PortalLogin</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>M4RestServlet</servlet-name>
    <url-pattern>/REST/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AxisServlet</servlet-name>
    <url-pattern>/servlet/AxisServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AxisServlet</servlet-name>
    <url-pattern>*.jws</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AxisServlet</servlet-name>
    <url-pattern>/services/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AdminServlet</servlet-name>
    <url-pattern>/servlet/AdminServlet</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>M4FileDownloadServlet</servlet-name>
    <url-pattern>/servlet/M4FileDownloadServlet</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>
  <taglib>
    <taglib-uri>M4Tags</taglib-uri>
    <taglib-location>/WEB-INF/M4Tags.tld</taglib-location>
  </taglib>
</web-app>

