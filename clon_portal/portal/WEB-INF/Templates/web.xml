	<!-- Filter to measure web time -->
	<filter>
		<filter-name>M4BenchFilter</filter-name>
		<filter-class>com.meta4.filters.bench.M4BenchFilter</filter-class>
	</filter>
	<!-- Filter to handle centralized session storage -->
	<filter>
		<filter-name>M4SessionStorageFilter</filter-name>
		<filter-class>com.meta4.filters.M4SessionStorageFilter</filter-class>
	</filter>
	<filter>
		<filter-name>M4AddHeadersFilter</filter-name>
		<filter-class>com.meta4.filters.addheaders.M4AddHeadersFilter</filter-class>
		<init-param>
			<param-name>enable</param-name>
			<param-value>false</param-value>
		</init-param>
	</filter>
	<!-- Filter to handle SSO -->
	<filter>
		<filter-name>M4WebSSOFilter</filter-name>
		<filter-class>com.meta4.filters.websso.M4WebSSOFilter</filter-class>
		<init-param>
			<param-name>netpattern</param-name>
			<param-value>^/hrpn8</param-value>
		</init-param>
		<init-param>
			<param-name>desktoppattern</param-name>
			<param-value>^/desktop</param-value>
		</init-param>
		<init-param>
			<param-name>oauth2pattern</param-name>
			<param-value>^/oauth2</param-value>
		</init-param>
		<init-param>
			<param-name>esspattern</param-name>
			<param-value>/</param-value>
		</init-param>
		<init-param>
			<param-name>enable</param-name>
			<param-value>false</param-value>
		</init-param>
	</filter>
	<!-- Filter to handle SOAP -->
	<filter>
		<filter-name>M4SOAPAutoGenerationFilter</filter-name>
		<filter-class>com.meta4.filters.soapservices.M4SOAPAutoGenerationFilter</filter-class>
		<init-param>
			<param-name>enable</param-name>
			<param-value>false</param-value>
		</init-param>
		<init-param>
			<param-name>fix</param-name>
			<param-value>true</param-value>
		</init-param>
	</filter>
	<!-- Filter to handle Unicode requests -->
	<filter>
		<filter-name>M4RequestEncodingFilter</filter-name>
		<filter-class>com.meta4.filters.i18n.M4RequestEncodingFilter</filter-class>
		<init-param>
			<param-name>enable</param-name>
			<param-value>true</param-value>
		</init-param>
	</filter>
	<!-- Filter to handle access to /temp -->
	<filter>
		<filter-name>M4CheckAccessFilter</filter-name>
		<filter-class>com.meta4.filters.access.M4CheckAccessFilter</filter-class>
	</filter>
	<!-- Filter to manage client side cache and other details -->
	<filter>
		<filter-name>M4URIRenamer</filter-name>
		<filter-class>com.meta4.filters.urirenamer.M4URIRenamerFilter</filter-class>
		<init-param>
			<param-name>enable</param-name>
			<param-value>false</param-value>
		</init-param>
	</filter>
	<!-- Filter to manage security -->
	<filter>
		<filter-name>M4SecurityHandlerFilter</filter-name>
		<filter-class>com.meta4.filters.security.M4SecurityHandlerFilter</filter-class>
		<init-param>
			<param-name>enable</param-name>
			<param-value>false</param-value>
		</init-param>
	</filter>
	<!-- Filter to manage page injection  -->
	<filter>
		<filter-name>M4JSFilter</filter-name>
		<filter-class>com.meta4.filters.js.M4JSFilter</filter-class>
		<init-param>
			<param-name>enable</param-name>
			<param-value>true</param-value>
		</init-param>
	</filter>
	<!-- Filter to allow product personalization by organization -->
	<filter>
		<filter-name>M4RedirectFilter</filter-name>
		<filter-class>com.meta4.filters.redirect.M4RedirectFilter</filter-class>
		<init-param>
			<param-name>enable</param-name>
			<param-value>false</param-value>
		</init-param>
		<init-param>
			<param-name>exclude</param-name>
			<param-value>^/temp/</param-value>
		</init-param>
	</filter>
	<!-- Filter to manage specific m4jsapi headers and cookies  -->
	<filter>
		<filter-name>M4JSAPIFilter</filter-name>
		<filter-class>com.meta4.js.filter.M4JSAPIFilter</filter-class>
		<init-param>
			<param-name>enable</param-name>
			<param-value>true</param-value>
		</init-param>
	</filter>
	<!-- Filter to match extensions to content types  -->
	<filter>
		<filter-name>M4DownloadBlobFilter</filter-name>
		<filter-class>com.meta4.tcservlets.download_blob_filter</filter-class>
	</filter>
