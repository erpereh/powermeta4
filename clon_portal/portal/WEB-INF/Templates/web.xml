		<filter-name>M4SecurityHandlerFilter</filter-name>
		<url-pattern>*.htm</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4SecurityHandlerFilter</filter-name>
		<url-pattern>*.js</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4SecurityHandlerFilter</filter-name>
		<url-pattern>/servlet/login</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4SecurityHandlerFilter</filter-name>
		<url-pattern>/servlet/SafePageProvider</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4JSFilter</filter-name>
		<url-pattern>*.js</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4JSFilter</filter-name>
		<url-pattern>*.jsp</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4JSFilter</filter-name>
		<url-pattern>*.html</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4JSFilter</filter-name>
		<url-pattern>*.htm</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4RedirectFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4JSAPIFilter</filter-name>
		<url-pattern>/servlet/M4JSExecutor/*</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4JSAPIFilter</filter-name>
		<url-pattern>/servlet/M4JSServices/*</url-pattern>
	</filter-mapping>
	<filter-mapping>
		<filter-name>M4DownloadBlobFilter</filter-name>
		<url-pattern>/servlet/getfile/*</url-pattern>
	</filter-mapping>
	<servlet>
		<servlet-name>Kaptcha</servlet-name>
		<servlet-class>com.google.code.kaptcha.servlet.KaptchaServlet</servlet-class>
		<init-param>
			<param-name>kaptcha.border</param-name>
			<param-value>no</param-value>
		</init-param>
		<init-param>
			<param-name>kaptcha.textproducer.font.color</param-name>
			<param-value>black</param-value>
		</init-param>
		<init-param>
			<param-name>kaptcha.textproducer.char.space</param-name>
			<param-value>5</param-value>
		</init-param>
	</servlet>
