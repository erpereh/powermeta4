<taglib>
	<tlibversion>1.0</tlibversion>
	<jspversion>1.1</jspversion>
	<shortname>m4taglib</shortname>
	<info>Meta4 Spain Tag Library</info>
	<tag>
		<name>date</name>
		<tagclass>com.meta4.taglib.M4Date</tagclass>
		<bodycontent>empty</bodycontent>
		<info>A date tag</info>
	</tag>
	<tag>
		<name>chronostart</name>
		<tagclass>com.meta4.taglib.bench.M4ChronoStart</tagclass>
		<bodycontent>empty</bodycontent>
		<info>A bench utility tag</info>
		<attribute>
			<name>id</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>chronostop</name>
		<tagclass>com.meta4.taglib.bench.M4ChronoStop</tagclass>
		<bodycontent>empty</bodycontent>
		<info>A bench utility tag</info>
		<attribute>
			<name>id</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>addtranslation</name>
		<tagclass>com.meta4.taglib.M4TagAddTranslation</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Define an item to translate</info>
		<attribute>
			<name>m4translation</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>beginjob</name>
		<tagclass>com.meta4.taglib.M4TagBeginJob</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Start a transaction</info>
	</tag>
	<tag>
		<name>checklink</name>
		<tagclass>com.meta4.taglib.M4TagCheckLink</tagclass>
		<bodycontent>JSP</bodycontent>
		<info>Check the security of a link</info>
		<attribute>
			<name>taskname</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>clearbag</name>
		<tagclass>com.meta4.taglib.M4TagClearBag</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Clear the user's bag</info>
	</tag>
	<tag>
		<name>conditional</name>
		<tagclass>com.meta4.taglib.M4TagConditional</tagclass>
		<bodycontent>JSP</bodycontent>
		<info>Conditionally displays its body based on its attribute values</info>
		<attribute>
			<name>include</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>exclude</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>match</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>count</name>
		<tagclass>com.meta4.taglib.M4TagCount</tagclass>
		<teiclass>com.meta4.teilib.M4TeiCount</teiclass>
		<bodycontent>empty</bodycontent>
		<info>Write the number of records</info>
		<attribute>
			<name>m4name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4place</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!-- Valid values are (LOCAL|REMOTE) -->
		</attribute>
		<attribute>
			<name>m4varname</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>outputdef</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>var</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>vartype</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>crosslink</name>
		<tagclass>com.meta4.taglib.M4TagGetLink</tagclass>
		<bodycontent>JSP</bodycontent>
		<info>Display the local link needed for single sign on</info>
		<attribute>
			<name>uri</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>idprovider</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>current</name>
		<tagclass>com.meta4.taglib.M4TagCurrent</tagclass>
		<teiclass>com.meta4.teilib.Current</teiclass>
		<bodycontent>empty</bodycontent>
		<info>Write the current position of the current record</info>
		<attribute>
			<name>m4name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4varname</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>outputdef</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>var</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>vartype</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>datadef</name>
		<tagclass>com.meta4.taglib.M4TagDataDef</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Enable access to data in the M4 Application Server</info>
		<attribute>
			<name>m4name</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4o</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4preserve</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!-- Valid values are (TRUE|FALSE) -->
		</attribute>
		<attribute>
			<name>m4id_app_role</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4start_date</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4end_date</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4id_rsm</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4id_organization</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4find</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!-- Valid values are (TRUE|FALSE) -->
		</attribute>
	</tag>
	<tag>
		<name>dataloop</name>
		<tagclass>com.meta4.taglib.M4TagDataLoop</tagclass>
		<bodycontent>JSP</bodycontent>
		<info>Loop through a set of records</info>
		<attribute>
			<name>start</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>stop</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>count</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>outputdef</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>dataloopstop</name>
		<tagclass>com.meta4.taglib.M4TagDataLoopStop</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Stops iteration of a parent dataloop tag (after current iteration finishes)</info>
		<attribute>
			<name>outputdef</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>endjob</name>
		<tagclass>com.meta4.taglib.M4TagEndJob</tagclass>
		<bodycontent>empty</bodycontent>
		<info>End a transaction and check errors</info>
		<attribute>
			<name>m4check</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
			<!-- Valid values are (ERROR|WARNING|SUCCESS) -->
		</attribute>
		<attribute>
			<name>m4url</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4alias</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>endpage</name>
		<tagclass>com.meta4.taglib.M4TagEndPage</tagclass>
		<bodycontent>empty</bodycontent>
		<info>End the meta4 jsp page</info>
	</tag>
	<tag>
		<name>exec</name>
		<tagclass>com.meta4.taglib.M4TagExec</tagclass>
		<bodycontent>JSP</bodycontent>
		<info>Execution of methods</info>
		<attribute>
			<name>m4method</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4object</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>node</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>method</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>alias</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- Probably use of parameter tags in the body -->
	</tag>
	<tag>
		<name>executereport</name>
		<tagclass>com.meta4.taglib.M4TagReportDefinition</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Execute a report in the application server</info>
		<attribute>
			<name>idreport</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>syssentence</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>outputtype</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>otherparams</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>executereportsec</name>
		<tagclass>com.meta4.taglib.M4TagReportDefinitionSec</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Execute a report in the application server</info>
		<attribute>
			<name>idreport</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>syssentence</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>outputtype</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>otherparams</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>param</name>
		<tagclass>com.meta4.taglib.M4TagParam</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Generic parameter with name and value</info>
		<attribute>
			<name>name</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>value</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>filter</name>
		<tagclass>com.meta4.taglib.M4TagFilter</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Filter records</info>
		<attribute>
			<name>m4name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4filter</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>alias</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>node</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4object</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>firetranslation</name>
		<tagclass>com.meta4.taglib.M4TagFireTranslation</tagclass>
		<bodycontent>JSP</bodycontent>
		<info>Performs translation of items</info>
		<!-- Mandatory use of parameter tags in the body -->
	</tag>
	<tag>
		<name>getbagvalue</name>
		<tagclass>com.meta4.taglib.M4TagGetBagValue</tagclass>
		<teiclass>com.meta4.teilib.M4TeiVarname</teiclass>
		<bodycontent>empty</bodycontent>
		<info>Get one value from the user's bag</info>
		<attribute>
			<name>m4key</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4varname</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>getcurrency</name>
		<tagclass>com.meta4.taglib.M4TagGetCurrency</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Get data from a currency item</info>
		<attribute>
			<name>m4currency_value</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4currency_id</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4currency_date</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4currency_type</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<!-- Only one attribute is required -->
	</tag>
	<tag>
		<name>getfile</name>
		<tagclass>com.meta4.taglib.M4TagGetFile</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Retrieve a file, and print the name</info>
		<attribute>
			<name>m4name</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>gettranslation</name>
		<tagclass>com.meta4.taglib.M4TagGetTranslation</tagclass>
		<bodycontent>empty</bodycontent>
		<info>Get the translated code of an item</info>
		<attribute>
			<name>m4nametranslation</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>htmlsafe</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>jsafe</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>linesafe</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>img</name>
		<tagclass>com.meta4.taglib.M4TagImage</tagclass>
		<bodycontent>JSP</bodycontent>
		<info>Representation of HTML 'img' tag</info>
		<attribute>
			<name>src</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>alt</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>width</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>height</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>style</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>class</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>input</name>
		<tagclass>com.meta4.taglib.M4TagInput</tagclass>
		<bodycontent>jsp</bodycontent>
		<info>Representation of HTML 'input' tag</info>
		<attribute>
			<name>name</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>type</name>
			<required>true</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>value</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>checked</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>disabled</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>readonly</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>size</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>maxlength</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>src</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>tabindex</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>styleclass</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>class</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>style</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>onclick</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>onblur</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>onchange</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>onfocus</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>onselect</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>match</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
	</tag>
	<tag>
		<name>item</name>
		<tagclass>com.meta4.taglib.M4TagItem</tagclass>
		<teiclass>com.meta4.teilib.M4TeiItem</teiclass>
		<bodycontent>empty</bodycontent>
		<info>Write the value of an item</info>
		<attribute>
			<name>m4name</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4format</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>typename</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>m4varname</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>htmlsafe</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>jsafe</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>linesafe</name>
			<required>false</required>
			<rtexprvalue>true</rtexprvalue>
		</attribute>
		<attribute>
			<name>replaceliterals</name>
