# node:sqlite requires Node.js >=24.15 <25. The SQLite persistence uses no
# external native SQLite module, node-gyp or Visual Studio Build Tools.
 
# --- Datos locales -----------------------------------------------------
 
# Private data directory for SQLite, backups, temporary imports, and uploads.
POWERMETA4_DATA_DIR=./data
 
# Temporary PeopleNet catalog extraction connection. Server-side only.
# This login's SQL Server permissions must be verified before extraction.
PEOPLENET_DB_HOST=WPNETDESAPRE
PEOPLENET_DB_PORT=1433
 
#PEOPLENET_DB_NAME=M4PRE
#PEOPLENET_DB_USER=meta4pntpre
#PEOPLENET_DB_PASSWORD=M3t44_pre
 
PEOPLENET_DB_NAME=
PEOPLENET_DB_USER=
PEOPLENET_DB_PASSWORD=
 
PEOPLENET_DB_ENCRYPT=false
PEOPLENET_DB_TRUST_SERVER_CERTIFICATE=false
 
 
# --- Meta4 SOAP ----------------------------------------------------------
 
# Meta4 SOAP origin. Server-side only. Every service URL is derived from this
# base: /services/Login, /services/CSP_CONSULTA_ORO_INTRAN_NEW,
# /services/CSP_POWER4_USER_ALL, /services/CSP_POWER4_CONSULTA_ORO and
# /services/SRTC_LAUNCH_IMPORT. HTTPS, no trailing slash required.
META4_BASE_URL=https://wmeta4pre2.creditocaucion.es
 
# META4_HIRE_FILE_PATH is a directory, not a file. The server generates
# AltaPersonas_<usuario>_<YYYY-MM-DD_HH-mm-ss>.xls inside it and uses that
# same path to write, verify and fill ARG_PATH_FILE.
META4_HIRE_FILE_PATH=\\WMETA4PRE2\powermeta4\import_users_excel
META4_HIRE_TEMPLATE_PATH=./fuentes/HIRE/Hire_1_PERSONA.xls
 
# --- Autenticación de desarrollo -----------------------------------------
 
# Development-only local authentication. It is enabled only when NODE_ENV is
# exactly development and POWERMETA4_DEBUG_AUTH is exactly true; next start
# always disables it. No Meta4 token or connection is created in this mode.
POWERMETA4_DEBUG_AUTH=true
POWERMETA4_DEBUG_USERNAME=DEBUG
 
# --- Chat (IA genérica compatible con OpenAI) -----------------------------
 
# Global OpenAI-compatible chat, backed by Google's Gemini OpenAI-compatible
# endpoint. Project: Powermeta4 (projects/521059780850).
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
 
# Provider selection (see src/lib/ai/) - "http-compatible" talks the
# standard protocol already configured above, no vendor-specific code.
AI_PROVIDER=http-compatible
EMBEDDING_PROVIDER=http-compatible
 
# --- Embeddings (base de conocimiento) ------------------------------------
 
# Embedding model for the PDF knowledge base (src/lib/knowledge/), served by
# OpenRouter independently of the chat connection above (see
# EMBEDDING_BASE_URL/EMBEDDING_API_KEY in http-compatible.ts). This model's
# output is fixed at 2048 dimensions - it rejects any other value, so
# EMBEDDING_DIMENSIONS stays unset.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1/embeddings"
EMBEDDING_API_KEY=

EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
EMBEDDING_DIMENSIONS=4096

EMBEDDING_API_KEY2=
EMBEDDING_API_KEY3=
EMBEDDING_API_KEY4=
EMBEDDING_API_KEY5=

# --- Base de conocimiento (manuales PDF) ----------------------------------
 
# PDF manuals knowledge base: source folder to index with `npm run
# kb:ingest` (offline, never read per-question) and retrieval tuning. The
# curated official PeopleNet/Cegid library lives inside the repo itself.
KB_SOURCE_DIR=./manuales/oficiales
KB_CHUNK_SIZE_CHARS=1200
KB_CHUNK_OVERLAP_CHARS=150
KB_TOP_K=6
# Recalibrated for nvidia/nemotron-3-embed-1b:free: its cosine-similarity
# scores run much lower in absolute terms than gemini-embedding-001's did.
# Measured on the real manuals: irrelevant questions top out around ~0.09,
# relevant ones start around ~0.29+. 0.2 sits safely in between. This is
# per-embedding-model - recalibrate again if EMBEDDING_MODEL changes.
KB_MIN_SCORE=0.55
 
# --- Backups ---------------------------------------------------------------
 
# Backup limits; invalid values fall back to safe defaults.
POWERMETA4_BACKUP_MAX_COMPRESSED_BYTES=268435456
POWERMETA4_BACKUP_MAX_UNCOMPRESSED_BYTES=1073741824
POWERMETA4_BACKUP_MAX_ENTRIES=10000
POWERMETA4_BACKUP_MAX_SINGLE_FILE_BYTES=268435456
 
# Acceso rápido de desarrollo (solo NODE_ENV=development). No subir nunca a git.
POWERMETA4_QUICK_LOGIN_USERNAME=
POWERMETA4_QUICK_LOGIN_PASSWORD=
