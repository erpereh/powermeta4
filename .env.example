# node:sqlite requires Node.js >=24.15 <25. The SQLite persistence uses no
# external native SQLite module, node-gyp or Visual Studio Build Tools.

# Private data directory for SQLite, backups, temporary imports, and uploads.
POWERMETA4_DATA_DIR=./data

# Meta4 Login SOAP endpoint.
META4_LOGIN_URL=https://meta4desasoap.creditocaucion.es/services/Login

# Meta4 user-profile CSP endpoint. Requires SOAPAction: "" — set automatically
# by executeAuthenticatedSoap/the Meta4 login client, no per-call action needed.
META4_USER_PROFILE_URL=https://meta4desasoap.creditocaucion.es/services/CSP_CONSULTA_ORO_INTRAN_NEW

# Meta4 users list CSP endpoint. Society (ARG_SOCIEDAD) comes only from server
# operational context. Requires SOAPAction: "" — set automatically by
# executeAuthenticatedSoap.
META4_USERS_LIST_URL=https://meta4desasoap.creditocaucion.es/services/CSP_POWER4_USER_ALL

# Meta4 employee-detail CSP endpoint (CSP_POWER4_CONSULTA_ORO). Takes only
# ARG_EMP (employee id), no ARG_SOCIEDAD; the server checks the employee
# belongs to the caller's active society before calling this. Requires
# SOAPAction: "" — set automatically by executeAuthenticatedSoap.
META4_USERS_DETAIL_URL=https://meta4desasoap.creditocaucion.es/services/CSP_POWER4_CONSULTA_ORO

# Development-only local authentication. It is enabled only when NODE_ENV is
# exactly development and POWERMETA4_DEBUG_AUTH is exactly true; next start
# always disables it. No Meta4 token or connection is created in this mode.
POWERMETA4_DEBUG_AUTH=false
POWERMETA4_DEBUG_USERNAME=DEBUG

# Backup limits; invalid values fall back to safe defaults.
POWERMETA4_BACKUP_MAX_COMPRESSED_BYTES=268435456
POWERMETA4_BACKUP_MAX_UNCOMPRESSED_BYTES=1073741824
POWERMETA4_BACKUP_MAX_ENTRIES=10000
POWERMETA4_BACKUP_MAX_SINGLE_FILE_BYTES=268435456
