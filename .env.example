# Private data directory for SQLite, backups, temporary imports, and uploads.
POWERMETA4_DATA_DIR=./data

# Meta4 Login SOAP endpoint.
META4_LOGIN_URL=https://meta4desaop.creditocaucion.es/services/Login

# Backup limits; invalid values fall back to safe defaults.
POWERMETA4_BACKUP_MAX_COMPRESSED_BYTES=268435456
POWERMETA4_BACKUP_MAX_UNCOMPRESSED_BYTES=1073741824
POWERMETA4_BACKUP_MAX_ENTRIES=10000
POWERMETA4_BACKUP_MAX_SINGLE_FILE_BYTES=268435456
