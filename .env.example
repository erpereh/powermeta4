# node:sqlite requires Node.js >=24.15 <25. The SQLite persistence uses no
# external native SQLite module, node-gyp or Visual Studio Build Tools.

# Private data directory for SQLite, backups, temporary imports, and uploads.
POWERMETA4_DATA_DIR=./data

# Meta4 SOAP origin. Server-side only. Every service URL is derived from this
# base: /services/Login, /services/CSP_CONSULTA_ORO_INTRAN_NEW,
# /services/CSP_POWER4_USER_ALL, /services/CSP_POWER4_CONSULTA_ORO and
# /services/SRTC_LAUNCH_IMPORT. HTTPS, no trailing slash required.
META4_BASE_URL=https://meta4desasoap.creditocaucion.es

# META4_HIRE_FILE_PATH is a directory, not a file. The server generates
# AltaPersonas_<usuario>_<YYYY-MM-DD_HH-mm-ss>.xls inside it and uses that
# same path to write, verify and fill ARG_PATH_FILE. Example:
# \\WMETA4PRE2\powermeta4\import_users_excel\AltaPersonas_JORGE.SALVADOR_2026-09-22_12-25-30.xls
META4_HIRE_FILE_PATH=\\WMETA4PRE2\powermeta4\import_users_excel
META4_HIRE_TEMPLATE_PATH=./fuentes/HIRE/Hire_1_PERSONA.xls

# PeopleNet SQL Server, read-only catalogs for the hire form (currency,
# payment type, company bank by ID_ORGANIZATION = active society). Server-side
# only; put the real host and credentials in .env.local, never in this file.
PEOPLENET_DB_HOST=
PEOPLENET_DB_PORT=1433
PEOPLENET_DB_NAME=
PEOPLENET_DB_USER=
PEOPLENET_DB_PASSWORD=
PEOPLENET_DB_ENCRYPT=false
PEOPLENET_DB_TRUST_SERVER_CERTIFICATE=false

# Development-only local authentication. It is enabled only when NODE_ENV is
# exactly development and POWERMETA4_DEBUG_AUTH is exactly true; next start
# always disables it. No Meta4 token or connection is created in this mode.
POWERMETA4_DEBUG_AUTH=false
POWERMETA4_DEBUG_USERNAME=DEBUG

# Development-only quick login with a real Meta4 test user. Put the values in
# .env.local (ignored by git), never here. The password is read only on the
# server; the login page receives just the username. Ignored outside development.
POWERMETA4_QUICK_LOGIN_USERNAME=
POWERMETA4_QUICK_LOGIN_PASSWORD=

# Global OpenAI-compatible chat. All three values are required and are read
# only by the server; replace the placeholders in .env.local.
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-your-api-key
AI_MODEL=replace-with-your-model

# Which ChatProvider/EmbeddingProvider implementation to use (see
# src/lib/ai/). "http-compatible" is the only one shipped today - it speaks
# the standard HTTP chat-completions/embeddings protocol already configured
# above, whatever service AI_BASE_URL points to. A future provider (a
# different protocol/vendor) is added as a new case in
# src/lib/ai/get-chat-provider.ts / get-embedding-provider.ts, selected here
# without touching any caller.
AI_PROVIDER=http-compatible
EMBEDDING_PROVIDER=http-compatible

# Embedding model used to index/search the PDF knowledge base (see
# src/lib/knowledge/). By default reuses AI_BASE_URL/AI_API_KEY above, so a
# single provider can serve both chat and embeddings with no extra
# configuration. Set EMBEDDING_BASE_URL/EMBEDDING_API_KEY to point
# embeddings at a *different* service than the chat model uses - e.g. chat
# on one provider, a free/cheaper embeddings-only model on another. Leave
# EMBEDDING_DIMENSIONS unset for a model with a fixed output size (some
# reject any other value); set it only for a model that supports truncating
# its output to a requested size.
EMBEDDING_MODEL=replace-with-your-embedding-model
# EMBEDDING_BASE_URL=https://api.example.com/v1
# EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_DIMENSIONS=768

# Knowledge base: folder of PDF manuals to index with `npm run kb:ingest`
# (offline - never read at question-answering time) and chunking/retrieval
# tuning. See docs/knowledge-base-rag.md. KB_MIN_SCORE is specific to
# whichever EMBEDDING_MODEL is configured - different models produce very
# different cosine-similarity ranges, so recalibrate this whenever the
# embedding model changes (see docs/knowledge-base-rag.md).
KB_SOURCE_DIR=./manuales/oficiales
KB_CHUNK_SIZE_CHARS=1200
KB_CHUNK_OVERLAP_CHARS=150
KB_TOP_K=6
KB_MIN_SCORE=0.55

# Backup limits; invalid values fall back to safe defaults.
POWERMETA4_BACKUP_MAX_COMPRESSED_BYTES=268435456
POWERMETA4_BACKUP_MAX_UNCOMPRESSED_BYTES=1073741824
POWERMETA4_BACKUP_MAX_ENTRIES=10000
POWERMETA4_BACKUP_MAX_SINGLE_FILE_BYTES=268435456
