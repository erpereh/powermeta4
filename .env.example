# Local data
POWERMETA4_DATA_DIR=./data
 
# Meta4 SOAP
# Usado actualmente por Login y CSP_CONSULTA_ORO_INTRAN_NEW.
META4_BASE_URL=https://meta4.example.com
 
# PeopleNet SQL Server
PEOPLENET_DB_HOST=
PEOPLENET_DB_PORT=1433
PEOPLENET_DB_NAME=
PEOPLENET_DB_USER=
PEOPLENET_DB_PASSWORD=
PEOPLENET_DB_ENCRYPT=false
PEOPLENET_DB_TRUST_SERVER_CERTIFICATE=false
# Alta de personas en las tablas de PeopleNet: META4_HIRE_MODE=plan simula con
# lecturas reales sin grabar; vacío graba. Usuario de escritura propio
# (PEOPLENET_DB_WRITE_USER/_PASSWORD) o, si el de arriba ya puede escribir,
# PEOPLENET_DB_WRITE_USE_READ_USER=true para reutilizarlo.
META4_HIRE_MODE=
PEOPLENET_DB_WRITE_USE_READ_USER=false
PEOPLENET_DB_WRITE_USER=
PEOPLENET_DB_WRITE_PASSWORD=
 
# Autenticación de desarrollo
POWERMETA4_DEBUG_AUTH=false
POWERMETA4_DEBUG_USERNAME=DEBUG
 
# Chat IA
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=
AI_MODEL=
AI_PROVIDER=http-compatible
 
# Embeddings
EMBEDDING_PROVIDER=http-compatible
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
 
# Base de conocimiento
KB_SOURCE_DIR=./manuales/oficiales
KB_CHUNK_SIZE_CHARS=1200
KB_CHUNK_OVERLAP_CHARS=150
KB_TOP_K=6
KB_MIN_SCORE=0.55
 
# Backups
POWERMETA4_BACKUP_MAX_COMPRESSED_BYTES=268435456
POWERMETA4_BACKUP_MAX_UNCOMPRESSED_BYTES=1073741824
POWERMETA4_BACKUP_MAX_ENTRIES=10000
POWERMETA4_BACKUP_MAX_SINGLE_FILE_BYTES=268435456
